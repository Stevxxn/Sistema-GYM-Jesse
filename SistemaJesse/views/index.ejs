<%- include('partials/header') %>

<div class="row mb-5">
    <div class="col-md-6 offset-md-3">
        <div class="card text-center shadow-lg border-0">
            <div class="card-body p-5">
                <h2 class="card-title text-uppercase mb-4">🔐 Control de Acceso</h2>
                
                <% if (mensaje) { %>
                    <div class="alert alert-<%= tipoAlerta %> display-6 fw-bold animate__animated animate__pulse">
                        <%= mensaje %>
                    </div>
                <% } else { %>
                    <p class="text-muted">Escanee la huella o ingrese la cédula para validar.</p>
                <% } %>

                <form action="/acceso" method="POST" class="mt-4">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-dark text-white"><i class="fas fa-fingerprint"></i></span>
                        <input type="text" name="cedula" class="form-control" placeholder="Ingrese Cédula del Socio..." autofocus autocomplete="off">
                        <button class="btn btn-primary" type="submit">VALIDAR</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<% if (esAdmin) { %>
    <div class="text-center mb-4 animate__animated animate__fadeIn">
        <a href="/registrar" class="btn btn-outline-primary btn-lg shadow-sm">
            <i class="fas fa-user-plus"></i> Registrar Nuevo Socio
        </a>
    </div>
<% } %>

<div class="card shadow-sm">
    <div class="card-header bg-white border-bottom-0 pt-3">
        <h5 class="mb-0"><i class="fas fa-users text-primary"></i> Socios Registrados en MongoDB</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Cédula</th>
                        <th>Socio</th>
                        <th>Plan</th>
                        <th>Vencimiento</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (socios.length > 0) { %>
                        <% socios.forEach(socio => { %>
                            <tr>
                                <td><%= socio.cedula %></td>
                                <td class="fw-bold"><%= socio.nombres %> <%= socio.apellidos %></td>
                                <td>
                                    <% if(socio.membresia.tipo === 'Mensual') { %>
                                        <span class="badge bg-info text-dark">Mensual</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">Anual</span>
                                    <% } %>
                                </td>
                                <td><%= new Date(socio.membresia.fechaFin).toLocaleDateString() %></td>
                                <td>
                                    <% if (new Date(socio.membresia.fechaFin) >= new Date()) { %>
                                        <span class="badge bg-success">ACTIVO</span>
                                    <% } else { %>
                                        <span class="badge bg-danger">VENCIDO</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fas fa-folder-open fa-2x mb-2"></i><br>
                                No hay socios registrados aún.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>