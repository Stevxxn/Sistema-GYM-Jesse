<%- include('partials/header') %>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🛠️ Panel de Administración</h2>
        <div class="mb-3">
            <a href="/admin/crear-admin" class="btn btn-success">
                <i class="fas fa-user-shield"></i> Nuevo Admin
            </a>
        </div>
        <a href="/logout" class="btn btn-danger btn-sm">Cerrar Sesión</a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Cédula</th>
                            <th>Nombre</th>
                            <th>Plan</th>
                            <th>Fin Membresía</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% socios.forEach(socio => { %>
                            <tr>
                                <td><%= socio.cedula %></td>
                                <td><%= socio.nombres %> <%= socio.apellidos %></td>
                                <td><%= socio.membresia.tipo %></td>
                                <td><%= new Date(socio.membresia.fechaFin).toLocaleDateString() %></td>
                                <td>
                                    <a href="/admin/editar/<%= socio._id %>" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>
                                    <a href="/admin/eliminar/<%= socio._id %>" 
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('¿Seguro que quieres eliminar a este socio?')">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>