<%- include('partials/header') %>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🛠️ Panel de Administración</h2>
        <div class="mb-3">
             <a href="/admin/reportes" class="btn btn-info text-white me-2">
                <i class="fas fa-clipboard-list"></i> Ver Reportes
            </a>
            <a href="/logout" class="btn btn-danger">Cerrar Sesión</a>
        </div>
    </div>

    <div class="card shadow mb-5 border-primary">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">🛡️ Equipo de Administración</h5>
            <span class="badge bg-light text-dark"><%= admins.length %> Usuarios</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Usuario (Login)</th>
                            <th>Rol</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% admins.forEach(admin => { %>
                            <tr>
                                <td><i class="fas fa-user-tie text-muted me-2"></i><%= admin.nombre %></td>
                                <td><code><%= admin.usuario %></code></td>
                                <td><span class="badge bg-secondary">Administrador</span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="mt-2 text-end">
                <a href="/admin/crear-admin" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-plus"></i> Agregar Nuevo Admin
                </a>
            </div>
        </div>
    </div>

    <h3 class="mb-3 text-muted">💪 Gestión de Socios</h3>
    <div class="card shadow mb-5">
        <div class="card-header bg-dark text-white">
            Listado General de Clientes
        </div>
        <div class="card-body">
            <% if (socios.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cédula</th>
                                <th>Socio</th>
                                <th>Plan</th>
                                <th>Vencimiento</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% socios.forEach(socio => { %>
                                <tr>
                                    <td><%= socio.cedula %></td>
                                    <td class="fw-bold">
                                        <%= socio.nombres %> <%= socio.apellidos %>
                                    </td>
                                    <td>
                                        <% if(socio.membresia.tipo === 'Mensual') { %>
                                            <span class="badge bg-primary">Mensual</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark">Anual</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% 
                                            const fecha = new Date(socio.membresia.fechaFin);
                                            const hoy = new Date();
                                            // Si ya venció, ponemos texto rojo
                                            const claseColor = fecha < hoy ? 'text-danger fw-bold' : 'text-success';
                                        %>
                                        <span class="<%= claseColor %>">
                                            <%= fecha.toLocaleDateString() %>
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/admin/editar/<%= socio._id %>" class="btn btn-warning btn-sm text-dark">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="/admin/eliminar/<%= socio._id %>" class="btn btn-danger btn-sm" onclick="return confirm('¿Seguro que deseas eliminar a este socio?');">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="alert alert-warning text-center">
                    No hay socios registrados todavía.
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('partials/footer') %>